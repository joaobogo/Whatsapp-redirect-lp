# Copy this file to apps/web/.env.local and fill in the values.
# Never commit .env.local. In Vercel, add the same names under
# Project > Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...). The older "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only if you prefer the old name; leave empty when the line above is filled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "secret" key (sb_secret_...) or the older service_role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# No Claude key goes here. The chat and the bots run on the worker computers,
# each with its own Claude access (see apps/worker/.env.example).
