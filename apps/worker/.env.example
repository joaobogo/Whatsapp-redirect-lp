# Copy this file to apps/worker/.env on each worker computer and fill it in.
# Never commit .env. One line per setting, no quotes needed.

# Supabase > Project Settings > API
SUPABASE_URL=
# The "secret" key (sb_secret_...) or the older service_role key
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com > API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_MODEL_FAST=

# A short name for this computer: pichau-desktop | windows | chromebook
WORKER_NAME=
WORKER_MAX_CONCURRENCY=
# true if this computer has Chrome and may run the browser bots
WORKER_HAS_BROWSER=
# true on ONE computer only (the always-on desktop)
WORKER_IS_SCHEDULER=
BROWSER_PROFILE_DIR=
APPLICANT_PROFILE_JSON=

# Phase 9 only (optional Google Sheet mirror)
GOOGLE_SERVICE_ACCOUNT_JSON=
SALES_QUEUE_SHEET_ID=
SALES_QUEUE_TAB=
