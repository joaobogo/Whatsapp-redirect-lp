# Copy this file to apps/worker/.env on each worker computer and fill it in.
# Never commit .env. One line per setting, no quotes needed.

# Supabase > Project Settings > API
SUPABASE_URL=
# The "secret" key (sb_secret_...) or the older service_role key
SUPABASE_SERVICE_ROLE_KEY=

# How this computer reaches Claude. Pick ONE:
#  1. Leave both lines empty: the worker uses this computer's own Claude login
#     (your Claude subscription). Run "claude" once on this computer and log in.
#  2. CLAUDE_CODE_OAUTH_TOKEN: a one-year token from "claude setup-token", for a
#     computer where you do not want to log in by hand. Also your subscription.
#  3. ANTHROPIC_API_KEY: pay-per-use API key from console.anthropic.com.
#     If this is filled in it is always used, even when the computer is logged in.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_MODEL_FAST=

# A short name for this computer: pichau-desktop | windows | chromebook
WORKER_NAME=
WORKER_MAX_CONCURRENCY=
# true if this computer has Chrome and may run the browser bots
WORKER_HAS_BROWSER=
# true if this computer also offers full desktop control (shown in the app; no bot uses it yet)
WORKER_HAS_DESKTOP=
# the login email of the person this computer belongs to (they can pause it from the app)
WORKER_OWNER_EMAIL=
# true on ONE computer only (the always-on desktop)
WORKER_IS_SCHEDULER=
BROWSER_PROFILE_DIR=
APPLICANT_PROFILE_JSON=

# Phase 9 only (optional Google Sheet mirror)
GOOGLE_SERVICE_ACCOUNT_JSON=
SALES_QUEUE_SHEET_ID=
SALES_QUEUE_TAB=
