{
  "name": "fgv-control-panel",
  "version": "1.0.0",
  "private": true,
  "description": "One-click control screen for Flow Group Ventures bots",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:build": "pnpm --filter @fgv/shared run seed:build",
    "db:test": "bash supabase/tests/run.sh",
    "worker:login": "pnpm --filter @fgv/worker run login",
    "worker:dev": "pnpm --filter @fgv/worker run dev",
    "worker:start": "pnpm --filter @fgv/worker run start",
    "e2e": "playwright test",
    "e2e:local": "bash e2e/local-supabase/run.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "pg": "^8.23.1"
  }
}
